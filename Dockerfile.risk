FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml requirements-risk.txt ./
COPY src ./src
RUN pip install --no-cache-dir -r requirements-risk.txt && useradd --uid 10001 --create-home heartlens
USER heartlens
ENV HEARTLENS_RISK_ARTIFACTS=/models
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "heart_research.risk_api:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
